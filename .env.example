# KA Events Environment Configuration

# Database path shared by the local scraper and web processes
DATABASE_PATH=./data/events.db

# Scraper interval in seconds (default: 6 hours = 21600)
SCRAPE_INTERVAL=21600

# Flask environment
FLASK_ENV=production

# --- Scraper health alerts (optional) ---
# Leave SMTP_HOST empty to disable mail; problems are then only logged.
# Do not commit real credentials - use an app password, not your main one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Where alerts go. ALERT_EMAIL_FROM defaults to SMTP_USER if left empty.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Consecutive bad runs before an alert is sent (rides out transient outages)
ALERT_AFTER_FAILURES=2
